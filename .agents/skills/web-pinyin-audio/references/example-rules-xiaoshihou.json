{
  "_说明": [
    "构建期给每个汉字标拼音：先用 pypinyin（带词语上下文），再按本文件的规则**依次**改写（后面的规则覆盖前面的）。",
    "ctx：正则；用 «字» 标出要改的那个字（«» 不会出现在故事里），«» 前后的部分是它的上下文（可以用正则，如 (?:越|也|再)«种»；(?<![已归])«还»给）。",
    "py：改成的读音（声调数字，轻声用 5，ü 写作 v，如 nv3）。when：可选，只有当前读音在这个列表里才改（用来“只纠正 pypinyin 的默认值”）。",
    "这些规则就是“读音校对表”：新增/修改一条，重新 `python3 -X utf8 -I webapp/build.py` 即可；`python3 -X utf8 webapp/pinyin.py --review` 会重写 webapp/pinyin_review.md 供人工复核。"
  ],
  "rules": [
    {"ctx": "«得»", "py": "de5", "when": ["de2"], "note": "结构助词：写得好、走得快、冷得像冰"},
    {"ctx": "(?:^|[，。；：！？“”—…、\\s]|[总也都便就还可们人])«得»(?=[一-鿿])", "py": "dei3", "note": "得（děi）：总得有人做、你们得当心、也得走、都得写清"},
    {"ctx": "«得»了便宜", "py": "de2", "note": "得了便宜（dé）；认得了/记得了是轻声，不能改"},

    {"ctx": "«着»", "py": "zhe5", "when": ["zhao2", "zhuo2", "zhao1", "zhe2"], "note": "助词：围着、点着灯、戴着、眯着、沉着"},
    {"ctx": "睡«着»", "py": "zhao2"},
    {"ctx": "扎«着»手", "py": "zhao2", "note": "别扎着手（被扎到）"},
    {"ctx": "得«着»", "py": "zhao2", "note": "用得着"},
    {"ctx": "不«着»", "py": "zhao2", "note": "睡不着、够不着（结果补语）。注意：不要泛化成“动词+着”，看着/拿着是轻声 zhe"},
    {"ctx": "(?<![一-鿿])«着»(?:火|急|凉|迷)", "py": "zhao2", "note": "只改词首的着（着火/着急）；围着火堆、吐着火苗是轻声 zhe，不能改"},
    {"ctx": "(?:衣|附|执)«着»", "py": "zhuo2"},
    {"ctx": "«着»(?:陆|装|色|重|想|实|落|力|笔|墨)", "py": "zhuo2"},

    {"ctx": "(.)\\1«地»", "py": "de5", "note": "助词：远远地看、懒懒地睁眼"},
    {"ctx": "(.)\\1(.)\\2«地»", "py": "de5", "note": "安安静静地"},
    {"ctx": "不动«地»", "py": "de5", "note": "一动不动地立着"},
    {"ctx": "好奇«地»", "py": "de5"},

    {"ctx": "«数»(?=过|到)", "py": "shu3", "note": "她数过…、先数到十"},
    {"ctx": "快«干»了", "py": "gan1", "note": "井快干了"},
    {"ctx": "«落»", "py": "luo4", "when": ["la4"], "note": "落下、落了榜、霜落了一地：全书都是 luò"},
    {"ctx": "«担»", "py": "dan4", "when": ["dan1"], "note": "一担新米、半担水（量词）"},
    {"ctx": "«担»(?=心|当|任|保|忧|待|负|惊)", "py": "dan1"},
    {"ctx": "(?<![已归偿退送])«还»给", "py": "hai2", "note": "还给猫备一只碗（副词），已还给失主（huán）不改"},

    {"ctx": "«长»", "py": "chang2", "when": ["zhang3"], "note": "默认 cháng：很长、走不长、长街、长夜"},
    {"ctx": "«长»(?:大|成|出|得|一智|什么)", "py": "zhang3", "note": "长大、长出来、便长得旺"},
    {"ctx": "(?:兄|士)«长»", "py": "zhang3"},
    {"ctx": "«长»代", "py": "zhang3", "note": "长辈（原文写作“长代”）"},

    {"ctx": "(?:越|也|再|又|去|来|在|要|先|边|才|能)«种»", "py": "zhong4", "note": "种（zhòng）：越种越多、也种瓜"},
    {"ctx": "«种»(?:瓜|豆|菜|稻|麦|树|花|草|田|下|果|粮|秧)", "py": "zhong4"},
    {"ctx": "(?:这|那|各|某|哪|每|多|几|一|两|三|何)«种»", "py": "zhong3", "when": ["zhong4"], "note": "这种地方、一种像兔的：量词/名词"},

    {"ctx": "«背»(?=着|起)", "py": "bei1", "note": "背着口袋、她背起柜"},
    {"ctx": "背上«背»过", "py": "bei1"},
    {"ctx": "«看»桥", "py": "kan1", "note": "大鱼看桥（kān，看守）"},
    {"ctx": "替(?:你们|我们)«看»着", "py": "kan1"},
    {"ctx": "«大»夫", "py": "dai4"},
    {"ctx": "«行»人", "py": "xing2", "note": "行人"},
    {"ctx": "«难»处", "py": "nan2"},
    {"ctx": "得«当»心", "py": "dang1"},
    {"ctx": "一«斗»米", "py": "dou3"},
    {"ctx": "意«思»", "py": "si5", "note": "意思、不好意思"},
    {"ctx": "用«尽»", "py": "jin4"},
    {"ctx": "刨«子»", "py": "zi5"},
    {"ctx": "«谁»", "py": "shui2", "when": ["shei2"], "note": "统一用 shuí（音频库里有）"}
  ],
  "neutral": {
    "_说明": "轻声（5）没有录音：构建期用该音节“现成录音里最接近低而短的那一声”（优先顺序 prefer）截短渐弱模拟；individual 里可以逐个指定本调。",
    "prefer": [3, 4, 2, 1],
    "individual": {}
  }
}
