{
  "title": "雪地里的那盏灯",
  "fps": 30,
  "scenes": [
    {
      "id": "s0-title",
      "len": 5,
      "cues": []
    },
    {
      "id": "s1-lost",
      "len": 30.5,
      "cues": [
        {
          "gap": 2.0,
          "text": "发现自己一个人站在一片大森林里。"
        },
        {
          "gap": 3.0,
          "text": "远远的山顶上，有一点小小的光"
        },
        {
          "gap": 1.4,
          "text": "那一定是我家的灯。"
        },
        {
          "gap": 1.6,
          "text": "一步一步，在雪地里往前走。"
        }
      ]
    },
    {
      "id": "s2-rabbit",
      "len": 21,
      "cues": [
        {
          "gap": 1.2,
          "text": "雪地里有两只长耳朵在动。"
        },
        {
          "gap": 1.0,
          "text": "我叫问号。"
        },
        {
          "gap": 2.0,
          "text": "两个人一起怕，比一个人怕好一点。"
        }
      ]
    },
    {
      "id": "s3-turtle",
      "len": 22,
      "cues": [
        {
          "gap": 1.2,
          "text": "是一只很老很老的乌龟。"
        },
        {
          "gap": 1.0,
          "text": "大家……都叫我……慢慢。"
        },
        {
          "gap": 1.4,
          "text": "这是……一张地图。"
        },
        {
          "gap": 1.0,
          "text": "我背着你。"
        }
      ]
    },
    {
      "id": "s4-river",
      "len": 35,
      "cues": [
        {
          "gap": 4.0,
          "text": "冰“啪”的一声，破了！"
        },
        {
          "gap": 3.4,
          "text": "一头巨大的白鹿，从雪雾里走了出来。"
        },
        {
          "gap": 1.4,
          "text": "轻轻一抬，把他托出了水面，救了上来。"
        },
        {
          "gap": 1.4,
          "text": "刚才，我好怕。"
        },
        {
          "gap": 0.8,
          "text": "我知道。"
        }
      ]
    },
    {
      "id": "s5-fire",
      "len": 30,
      "cues": [
        {
          "gap": 1.5,
          "text": "火着起来了，洞里一下子亮了，暖了。"
        },
        {
          "gap": 1.4,
          "text": "妈妈会在我的窗边点一盏小灯。"
        },
        {
          "gap": 0.6,
          "text": "她说，夜里醒来，看见灯，便不怕了。"
        },
        {
          "gap": 1.2,
          "text": "小石头点点头，眼睛里有了泪光。"
        }
      ]
    },
    {
      "id": "s6-wolf",
      "len": 31.5,
      "cues": [
        {
          "gap": 3.0,
          "text": "狼！是狼！"
        },
        {
          "gap": 4.2,
          "text": "你怕的东西，有时候也在怕你。"
        },
        {
          "gap": 2.4,
          "text": "狼妈妈看着他们，没有扑过来。"
        },
        {
          "gap": 1.2,
          "text": "对他们点了点头，带着小狼走了。"
        }
      ]
    },
    {
      "id": "s7-thaw",
      "len": 17,
      "cues": [
        {
          "gap": 1.6,
          "text": "雪水流成了小溪，小溪流进了河。"
        },
        {
          "gap": 2.8,
          "text": "山顶的灯，好像近了一点。"
        }
      ]
    },
    {
      "id": "s8-summit",
      "len": 36.5,
      "cues": [
        {
          "gap": 1.0,
          "text": "山很高，路很难走。"
        },
        {
          "gap": 5.5,
          "text": "他是守林人。"
        },
        {
          "gap": 1.8,
          "text": "我以为……这是我的家。"
        },
        {
          "gap": 1.8,
          "text": "迷路的人，最需要看见一点光。"
        },
        {
          "gap": 1.4,
          "text": "灯是由我点的，\n可是光，是给每一个人的。"
        }
      ]
    },
    {
      "id": "s9-farewell",
      "len": 34,
      "cues": [
        {
          "gap": 1.0,
          "text": "一把抱住了小石头，抱了很久很久。"
        },
        {
          "gap": 1.4,
          "text": "你还会回来吗？"
        },
        {
          "gap": 1.0,
          "text": "路……我已经记在……壳上了。"
        },
        {
          "gap": 1.0,
          "text": "你也可以做别人的灯。"
        },
        {
          "gap": 1.2,
          "text": "是一起走路的朋友。"
        }
      ]
    },
    {
      "id": "s10-window",
      "len": 28,
      "cues": [
        {
          "gap": 1.6,
          "text": "点了一盏小灯。"
        },
        {
          "gap": 1.4,
          "text": "这是给森林里的朋友，\n还有所有迷路的人。"
        },
        {
          "gap": 1.6,
          "text": "也有一点小小的光，一闪一闪的。"
        },
        {
          "gap": 1.2,
          "text": "他微笑着，闭上了眼睛。"
        }
      ]
    }
  ]
}